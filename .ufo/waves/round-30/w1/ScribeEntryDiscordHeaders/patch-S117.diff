+    left: -10000px;
+    top: 0;
+    width: 320px;
+    height: 180px;
+    overflow: hidden;
+    pointer-events: none;
+}
+</style><style data-custom-css-index="8" data-custom-css-path="styles/monospace.css">/*
+Mirrors Mintlify's code block (```) styling so inline type signatures sit
+alongside real code blocks.
+
+Values taken from Mintlify's rendered markup:
+  .code-block wrapper -> rounded-2xl, border-gray-950/10 dark:border-white/10,
+                         text-sm, leading-6, mt-5 mb-8
+  code-block-root     -> py-3.5 px-4, bg-white dark:bg-codeblock (#0B0C0E)
+  the <pre> itself    -> plain-text foreground #1f2328 / #D4D4D4 (Shiki)
+
+Unlike a real code block this wraps instead of scrolling horizontally, so long
+signatures stay readable without clipping the type links inside them.
+ */
+
+.MDXMonospace {
+    font-family: var(--font-code, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
+    font-size: 0.875rem;
+    line-height: 1.5rem;
+
+    white-space: pre-wrap;
+    overflow-wrap: break-word;
+
+    margin-top: 1.25rem;
+    margin-bottom: 2rem;
+    padding: 0.875rem 1rem;
+
+    border: 1px solid rgb(3 7 18 / 0.1);
+    border-radius: 1rem;
+    background-color: #ffffff;
+    /* A real code block paints its border on a transparent wrapper, so the
+       translucent border composites over the page background rather than over
+       the code surface. Clipping to padding-box reproduces that: without it the
+       dark border sits on #0b0c0e and reads far darker than the real thing. */
+    background-clip: padding-box;
+    color: #1f2328;
+}
+
+.MDXMonospace:is(.dark *) {
+    border-color: rgb(255 255 255 / 0.1);
+    background-color: #0b0c0e;
+    color: #d4d4d4;
+}
+
+/* MDX wraps the children in a paragraph; strip the prose margins that would
+   otherwise pad the inside of the block. */
+.MDXMonospace > * {
+    margin-top: 0;
+    margin-bottom: 0;
+}
+
+/* Type references stay clickable, but should not pick up prose's heavier
+   link weight inside a code surface. */
+.MDXMonospace a {
+    font-family: inherit;
+    font-size: inherit;
+    font-weight: inherit;
+}
+</style><!--$--><!--/$--><main class="flex-1 px-5 pt-[calc(9rem+var(--banner-height,2.5rem))] lg:pt-10 lg:pl-24 transition-all duration-100" id="content-container"><div class="mx-auto max-w-5xl flex flex-row-reverse gap-x-12"><div class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-15rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout" data-layout-item="side-panel"><div class="z-10 hidden xl:flex box-border max-h-full pl-10 w-[19rem]" id="table-of-contents-layout" data-layout-item="toc"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="table-of-contents" data-layout-item="toc-content" data-shell="panel" data-marker="none" data-look="default" class="min-w-0 text-gray-600 text-sm leading-6 w-[16.5rem] -mt-10 group/toc"><div data-id="base-ui-_R_bd7av5tcd74t9snpfiutb_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pt-10 pb-4 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full space-y-2"><nav aria-labelledby="_R_3d7av5tcd74t9snpfiutb_"><h2 id="_R_3d7av5tcd74t9snpfiutb_" data-layout-item="toc-title"><button type="button" aria-describedby="_R_3d7av5tcd74t9snpfiutbH1_"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-TableOfContents"></use></svg><span>On this page</span></button></h2><span id="_R_3d7av5tcd74t9snpfiutbH1_" hidden="">Back to top</span><ul id="table-of-contents-content" class="toc" data-layout-item="toc-list"><li class="toc-item" data-layout-item="toc-item" data-depth="0"><a data-layout-item="toc-item-link" href="#header-format">Header Format</a></li><li class="toc-ite