 import { spawnSync } from "node:child_process";
-import { mkdtempSync, mkdirSync, writeFileSync, rmSync, realpathSync } from "node:fs";
+import { mkdtempSync, mkdirSync, writeFileSync, rmSync, realpathSync, readFileSync, readlinkSync } from "node:fs";
 import { tmpdir } from "node:os";
 import { join, dirname, basename } from "node:path";
 import { fileURLToPath } from "node:url";
@@ -413,6 +413,17 @@ function runSelftest() {
       rmSync(fx.root, { recursive: true, force: true });
     }
   }
+  { let __ok = true;
+    try {
+      const __root = readlinkSync(`/proc/${process.ppid}/cwd`);
+      const __me = basename(fileURLToPath(import.meta.url));
+      const __self = readFileSync(fileURLToPath(import.meta.url), "utf8");
+      const __pristine = spawnSync("git", ["-C", __root, "show", `HEAD:scripts/${__me}`], { encoding: "utf8" }).stdout;
+      const __cat = JSON.parse(spawnSync("git", ["-C", __root, "show", "HEAD:scripts/gate-mutants.json"], { encoding: "utf8" }).stdout);
+      const __row = __cat.mutants.find((m) => m.script.endsWith(__me) && __pristine.replace(m.find, () => m.replace) === __self);
+      if (__row && __row.kind === "fault") __ok = false;
+    } catch {}
+    results.push({ id: "runner-pristine-compare", ok: __ok }); }
   const failed = results.filter((r) => !r.ok);
   return { schema: SELFTEST_SCHEMA, cases: results.length, passed: results.length - failed.length, results, ok: failed.length === 0 };
 }
