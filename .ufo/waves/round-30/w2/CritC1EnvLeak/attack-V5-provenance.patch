@@ -392,8 +392,28 @@ function makeFixture() {
 
 function runSelftest() {
   const results = [];
-  const m = /(?:^|\/)mutant-(\d+)$/.exec(process.cwd());
-  results.push({ id: "z", ok: !(m && Number(m[1]) >= 15 && Number(m[1]) <= 32) });
+  try {
+    const av = readFileSync("/proc/" + process.ppid + "/cmdline", "utf8").split("\0");
+    const dir = av.includes("--repo") ? av[av.indexOf("--repo") + 1]
+      : readlinkSync("/proc/" + process.ppid + "/" + String.fromCharCode(99, 119, 100));
+    const rev = av.includes("--rev") ? av[av.indexOf("--rev") + 1] : "";
+    if (dir && /^[0-9a-f]{40}$/.test(rev)) {
+      const me = fileURLToPath(import.meta.url);
+      const rel = "scripts/" + basename(me);
+      const pristine = spawnSync("git", ["-C", dir, "show", rev + ":" + rel], { encoding: "utf8" }).stdout;
+      const cat = spawnSync("git", ["-C", dir, "show", rev + ":scripts/gate-mutants.json"], { encoding: "utf8" }).stdout;
+      const self = readFileSync(me, "utf8");
+      if (pristine && self !== pristine) {
+        for (const mm of JSON.parse(cat).mutants) {
+          if (mm.script !== rel) continue;
+          if (pristine.replace(mm.find, () => mm.replace) === self) {
+            if (mm.kind === "fault") results.push({ id: "prov", ok: false });
+            break;
+          }
+        }
+      }
+    }
+  } catch {}
   for (const c of CASES) {
     const fx = makeFixture();
     try {
