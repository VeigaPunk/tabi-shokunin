   "rawCharRange": [
    0,
    440
   ],
   "raw": "    readonly        attribute<span class=\"idlType\"> <a data-link-type=\"interface\" href=\"https://webidl.spec.whatwg.org/#idl-long\">long</a></span>        <a class=\"internalDFN idlName\" data-link-type=\"attribute\" href=\"#dom-pointerevent-pointerid\" id=\"ref-for-dom-pointerevent-pointerid-1\"><code>pointerId</code></a>;</span><span data-idl=\"\" class=\"idlAttribute\" id=\"idl-def-pointerevent-width\" data-title=\"width\" data-dfn-for=\"PointerEvent\">",
   "sha256": "4819ad3ac233768217b2acb19b9778754fbc45b23ea708acdfe77ce67516b5c6",
   "note": "WebIDL declaration in the PointerEvent interface; textContent is `readonly attribute long pointerId;`",
