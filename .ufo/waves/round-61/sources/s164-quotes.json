   "rawCharRange": [
    0,
    338
   ],
   "raw": "            <section id=\"pointerdown\"><div class=\"header-wrapper\"><h4 id=\"x3-3-3-pointerdown\"><bdi class=\"secno\">3.3.3 </bdi><dfn data-dfn-type=\"event\" id=\"dfn-pointerdown\" tabindex=\"0\" aria-haspopup=\"dialog\" data-export=\"\">pointerdown</dfn></h4><a class=\"self-link\" href=\"#pointerdown\" aria-label=\"Permalink for Section 3.3.3\"></a></div>",
   "sha256": "132932b0e9746b2ed42eba65a95fa982a2cd4765dd09e45d5e1c8d90f30e8bea",
   "note": "Section 3.3.3 pointerdown",
   "textNormalized": null
  },
  {
   "label": "pointerdown-event-definition-table",
   "site": "section id=\"pointerdown\" > table class=\"event-definition\" (raw 2229), rows raw 2232-2245",
   "rawLine": 2232,
   "rawLineRange": [
    2232,
    2245
   ],
   "raw": "                        <th>Type</th>\n                        <td><strong><code>pointerdown</code></strong></td>\n                    </tr>\n                    <tr>\n                        <th>Interface</th>\n                        <td><a data-link-type=\"idl\" data-lt=\"PointerEvent\" href=\"#dom-pointerevent\" class=\"internalDFN\" id=\"ref-for-dom-pointerevent-17\"><code>PointerEvent</code></a></td>\n                    </tr>\n                    <tr>\n                        <th>Bubbles</th>\n                        <td>Yes</td>\n                    </tr>\n                    <tr>\n                        <th>Cancelable</th>\n                        <td>Yes</td>\n                    </tr>",
   "sha256": "ea6c43291a9674887219a81c789d4a129865b4826240ebc97288a77792843bd2",
   "note": "Event table: Type pointerdown (2232-2233), Interface PointerEvent (2236-2237), Bubbles Yes (2240-2241), Cancelable Yes (2244-2245), Composed Yes (2248-2249)"
  },
  {
   "label": "pointerdown-definition-prose",
   "site": "section id=\"pointerdown\" paragraph raw 2261",
   "rawLine": 2261,
   "rawCharRange": [
    0,
    609
   ],
   "raw": "                <p>The  <a data-link-type=\"dfn\" href=\"https://infra.spec.whatwg.org/#user-agent\">user agent</a> <em class=\"rfc2119\">MUST</em> <a href=\"#dfn-fire-a-pointer-event\" class=\"internalDFN\" data-link-type=\"dfn\" id=\"ref-for-dfn-fire-a-pointer-event-4\">fire a pointer event</a> named <a data-link-type=\"idl\" data-lt=\"pointerdown\" href=\"#dfn-pointerdown\" class=\"internalDFN\" id=\"ref-for-dfn-pointerdown-11\"><code>pointerdown</code></a> when a pointer enters the <a href=\"#dfn-active-buttons-state\" class=\"internalDFN\" data-link-type=\"dfn\" id=\"ref-for-dfn-active-buttons-state-2\">active buttons state</a>.",
   "sha256": "6a7481d992312591c5503f522b3780b77daed06d5f35b9ca8efcdfd5c77362ed",
   "note": "Normative firing condition: MUST fire pointerdown when a pointer enters the active buttons state",
   "textNormalized": null
  },
