<p><style>
.wd-authors {
  --avatar-size: 65px;
  display: flex;
  gap: 2em;
}

.wd-author {
  display: flex;
  flex-wrap: wrap;
  gap: 1em;
  line-height: calc(var(--avatar-size) / 2);
}

.wd-author img {
  border-radius: 50%;
  height: var(--avatar-size, 65px);
  width: var(--avatar-size, 65px);
}

.dcc-authors {
  --avatar-size: 65px;
  display: flex;
  gap: 2em;
}

.dcc-author {
  display: flex;
  flex-wrap: wrap;
  gap: 1em;
  line-height: calc(var(--avatar-size) / 2);
}

.dcc-author img {
  border-radius: 50%;
  height: var(--avatar-size, 65px);
  width: var(--avatar-size, 65px);
}
  
.dcc-author__links {
  display: flex;
}

.dcc-author__links a {
  margin-inline-end: 6px;
}

.dcc-author__links a:last-of-type {
  margin-inline-end: 0;
}
</style>

</p><div class="dcc-authors" translate="no">
  
    
    
      <div class="dcc-author">
        
          <img alt="Alexandra Klepper" class="devsite-landing-row-item-icon" decoding="async" height="64" loading="lazy" src="https://web.dev/images/authors/alexandraklepper.jpg?hl=ja" width="64" /> 
        
        <div>
          <span> 
            Alexandra Klepper
          </span>
          <div class="dcc-author__links">
            
            
              <a aria-label="Alexandra Klepper on GitHub" href="https://github.com/alexandrascript" rel="me">
