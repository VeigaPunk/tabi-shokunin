<table class="full-width" id="availability">
  <tbody><tr>
    <th>说明类视频</th>
    <th>Web</th>
    <th>扩展程序</th>
    <th>Chrome 状态</th>
    <th>目的</th>
  </tr>
  <tr>
  
<td><a href="https://github.com/webmachinelearning/webmcp">GitHub</a></td>
<td><a href="https://developer.chrome.com/origintrials/?hl=zh-cn#/register_trial/4163014905550602241"><img alt="源试用" class="inline" height="16" src="https://developer.chrome.com/static/images/experiment.svg?hl=zh-cn" width="16" /> 源试用</a></td>
<td></td>
<td><a href="https://chromestatus.com/feature/5117755740913664" target="_blank">查看</a></td>
