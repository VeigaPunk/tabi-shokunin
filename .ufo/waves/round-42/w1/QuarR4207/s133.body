<p><style>
.wd-authors {
  --avatar-size: 65px;
  display: flex;
  gap: 2em;
}

.wd-author {
  display: flex;
  flex-wrap: wrap;
  gap: 1em;
  line-height: calc(var(--avatar-size) / 2);
}

.wd-author img {
  border-radius: 50%;
  height: var(--avatar-size, 65px);
  width: var(--avatar-size, 65px);
}

.dcc-authors {
  --avatar-size: 65px;
  display: flex;
  gap: 2em;
}

.dcc-author {
  display: flex;
  flex-wrap: wrap;
  gap: 1em;
  line-height: calc(var(--avatar-size) / 2);
}

.dcc-author img {
  border-radius: 50%;
  height: var(--avatar-size, 65px);
  width: var(--avatar-size, 65px);
}
  
.dcc-author__links {
  display: flex;
}

.dcc-author__links a {
  margin-inline-end: 6px;
}

.dcc-author__links a:last-of-type {
  margin-inline-end: 0;
}

/* Name, title and links stacked in a column centred against the avatar. */
.dcc-author--with-title > div {
  display: flex;
  flex-direction: column;
  justify-content: center;
  line-height: 1.3;
}

.dcc-author__title {
  color: var(--devsite-secondary-text-color);
  font-size: 0.875em;
}

.dcc-author--with-title .dcc-author__links {
  margin-block-start: 4px;
}
</style>

</p><div class="dcc-authors" translate="no">
  
    
    
