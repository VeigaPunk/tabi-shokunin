<span class="devsite-syntax-w">    </span><span class="devsite-syntax-p">{</span>
<span class="devsite-syntax-w">      </span><span class="devsite-syntax-nt">&quot;role&quot;</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-s2">&quot;user&quot;</span><span class="devsite-syntax-p">,</span>
<span class="devsite-syntax-w">      </span><span class="devsite-syntax-nt">&quot;content&quot;</span><span class="devsite-syntax-p">:</span><span class="devsite-syntax-w"> </span><span class="devsite-syntax-s2">&quot;I am looking to buy a black jacket and a pair of jeans.</span>
<span class="devsite-syntax-s2">        Could you provide a breakdown of the materials used ?&quot;</span>
<span class="devsite-syntax-w">    </span><span class="devsite-syntax-p">}</span>
