<p><style>
.wd-authors {
  --avatar-size: 65px;
  display: flex;
  gap: 2em;
}

.wd-author {
  display: flex;
  flex-wrap: wrap;
  gap: 1em;
  line-height: calc(var(--avatar-size) / 2);
}

.wd-author img {
  border-radius: 50%;
  height: var(--avatar-size, 65px);
  width: var(--avatar-size, 65px);
}

.dcc-authors {
  --avatar-size: 65px;
