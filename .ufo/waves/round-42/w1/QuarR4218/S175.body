<script>
(function(){
  /* ── 分享連結（依當前 URL 動態填入）── */
  var url = encodeURIComponent(window.location.href);
  var lineBtn = document.getElementById('naLineShareBtn');
  var fbBtn   = document.getElementById('naFbShareBtn');
  if (lineBtn) lineBtn.href = 'https://social-plugins.line.me/lineit/share?url=' + url;
  if (fbBtn)   fbBtn.href   = 'https://www.facebook.com/sharer/sharer.php?u=' + url;

  /* ── TOC scrollspy + smooth scroll ── */
  function initToc(){
    var tocLinks = document.querySelectorAll('#article-toc a[href^="#"]');
    if (!tocLinks.length) return;

    tocLinks.forEach(function(a){
      a.addEventListener('click', function(e){
        var id = a.getAttribute('href').slice(1);
        var target = document.getElementById(id);
        if (!target) return;
        e.preventDefault();
        var top = target.getBoundingClientRect().top + window.scrollY - 88;
        window.scrollTo({ top: top, behavior: 'smooth' });
        history.replaceState(null, '', '#' + id);
      });
    });

    var targets = Array.prototype.slice.call(tocLinks).map(function(a){
      return document.getElementById(a.getAttribute('href').slice(1));
    }).filter(Boolean);
    if (!targets.length) return;

    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (!en.isIntersecting) return;
        var a = document.querySelector('#article-toc a[href="#' + en.target.id + '"]');
        if (!a) return;
        tocLinks.forEach(function(l){ l.classList.remove('is-active'); });
        a.classList.add('is-active');
      });
    }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });

    targets.forEach(function(t){ io.observe(t); });
  }

  /* ── 動態建立 TOC（掃描 #article-body 內的 h2 並注入 #article-toc）── */
  function buildToc() {
    var article = document.getElementById('article-body');
    var tocNav  = document.getElementById('article-toc');
    if (!article || !tocNav) return;
    var tocOl = tocNav.querySelector('ol');
    if (!tocOl) return;

    var headings = article.querySelectorAll('h2');
    if (!headings.length) {
      tocNav.style.display = 'none';
      return;
    }

    var n = 0;
    headings.forEach(function(h) {
      if (!h.id) {
        n++;
        h.id = 'section-' + n;
      }
      var li = document.createElement('li');
      var a  = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent.trim();
      li.appendChild(a);
      tocOl.appendChild(li);
    });
  }

  buildToc();
  initToc();
})();
</script>

