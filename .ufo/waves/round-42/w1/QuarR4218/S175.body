<script>
(function(){
	/* -- Topbar scroll -- */
	var topbar = document.getElementById('topbar');
	window.addEventListener('scroll', function(){
		topbar.classList.toggle('scrolled', window.scrollY > 40);
	}, {passive:true});

	/* -- Move mobile nav into drawer -- */
	var mobileNav = document.querySelector('.cadch-mobile-nav');
	var drawer    = document.getElementById('mobileDrawer');
	if(mobileNav && drawer){
		drawer.insertBefore(mobileNav, drawer.firstChild);
		mobileNav.removeAttribute('aria-hidden');
		mobileNav.style.display = 'block';
	}

  /* -- Mobile drawer toggle -- */
	var navToggle = document.getElementById('navToggle');
	function setDrawer(open){
		navToggle.classList.toggle('is-open', open);
		drawer.classList.toggle('is-open', open);
		navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
		drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
		document.body.classList.toggle('nav-open', open);
	}
	if(navToggle){
			navToggle.addEventListener('click', function(){
				setDrawer(!drawer.classList.contains('is-open'));
			});
	}
	/* close on nav link click */
	document.querySelectorAll('.m-nav a').forEach(function(a){
		a.addEventListener('click', function(){ setDrawer(false); });
	});
	/* mobile L1 accordion */
	document.querySelectorAll('.m-parent').forEach(function(p){
		var toggle = function(){
			var li = p.parentElement;
			var open = li.classList.toggle('is-open');
			p.setAttribute('aria-expanded', open ? 'true' : 'false');
		};
		p.addEventListener('click', toggle);
		p.addEventListener('keydown', function(e){
			if(e.key==='Enter'||e.key===' '){ e.preventDefault(); toggle(); }
		});
	});
	/* mobile L2 accordion */
	document.querySelectorAll('.m-sub-parent').forEach(function(p){
		var toggle = function(e){
			e.stopPropagation();
			var li = p.parentElement;
			var open = li.classList.toggle('is-open');
			p.setAttribute('aria-expanded', open ? 'true' : 'false');
		};
		p.addEventListener('click', toggle);
		p.addEventListener('keydown', function(e){
			if(e.key==='Enter'||e.key===' '){ e.preventDefault(); toggle(e); }
		});
	});
	/* ESC closes drawer */
	window.addEventListener('keydown', function(e){
		if(e.key==='Escape' && drawer.classList.contains('is-open')) setDrawer(false);
	});
	/* close on resize to desktop */
	window.addEventListener('resize', function(){
		if(window.innerWidth >= 992 && drawer.classList.contains('is-open')) setDrawer(false);
	});
	
	/* -- Go to top -- */
	window.topFunction = function(){ window.scrollTo({top:0,behavior:'smooth'}); };
	
	ChccdScrollIndicator.init({
		container: 'body#system',
		//sectionSelector: 'section',
		//label: 'SCROLL',
		//position: 'left',
		//accent: '#cfa55f',
	});
})();
</script>

<script type="text/javascript">
//<![CDATA[
$(document).ready(function(){

	

	//menulist
	$("ul.rd-navbar-nav > li:nth-child(3)").after($("li.menulist"));
	$("li.menulist ul.rd-navbar-dropdown").removeClass('rd-navbar-dropdown');
	$("li.menulist ul.rd-navbar-megamenu li").removeClass('rd-navbar--has-dropdown').removeClass('rd-navbar-submenu');
	$("li.menulist ul span").remove();

	// headermenu special effects
	document.querySelectorAll(".rd-navbar-nav").forEach(el => {
	  el.addEventListener("mousemove", e => {
		const rect = el.getBoundingClientRect();
		const x = e.clientX - rect.left;
		const y = e.clientY - rect.top;
		el.style.setProperty("--x", `${x}px`);
		el.style.setProperty("--y", `${y}px`);
	  });
	});

	// header-search
	$('.nav-search-icon').on('click', function() {
		$('.nav-search').toggleClass('open');
		
		if ($('.nav-search').hasClass('open')) {
			console.log('nav-search 已加上 open class (已展開)');
		} else {
			console.log('nav-search 已移除 open class (已收合)');
		}
	});

	// wow
	new WOW().init();

	// header fix
		$("body:has(form#search),body:has(form#userinfo),body:has(form#user-register),body:has(span.user-register-note),body:has(div.system-userform),body:has(div.system-userinfo)").prev("head").append("<link>");
		css = $("head").children(":last");
		css.attr({
			rel: "stylesheet",
			type: "text/css",
			href: "https://www.np.com.tw/themes/CADCH_00037A/css/btpfix.css"
		});

	// fancybox
	$(".itembox").fancybox({
		fitToView	: false,
		width		: '100%',
		height		: '70%',
		autoSize	: false,
		closeClick	: false,
		openEffect	: 'none',
		closeEffect	: 'none',
		helpers : {
			title : {
				type : 'inside'
			},
			overlay : {
				css : {
					'background' : 'rgba(238,238,238,0.85)'
				}
			}
		}
	});

});

// totop
let mybutton = document.getElementById("totop");

// totop: When the user scrolls down 20px from the top of the document, show the button
window.onscroll = function() {scrollFunction()};

function scrollFunction() {
	if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
		mybutton.style.display = "block";
	} else {
		mybutton.style.display = "none";
	}
}

// totop: When the user clicks on the button, scroll to the top of the document
function topFunction() {
	document.body.scrollTop = 0; // For Safari
	document.documentElement.scrollTop = 0; // For Chrome, Firefox, IE and Opera
}


// popover
var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
	return new bootstrap.Popover(popoverTriggerEl)
});

