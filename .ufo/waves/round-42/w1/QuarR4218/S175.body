<style>
/* ── 設計 tokens（editorial 專用，不影響主題其他頁面）── */
:root {
  --bg: #ffffff;
  --bg-soft: #fafaf7;
  --bg-muted: oklch(0.965 0.005 250);
  --line: oklch(0.92 0.005 250);
  --line-strong: oklch(0.86 0.005 250);
  --ink: oklch(0.18 0.01 250);
  --ink-2: oklch(0.32 0.01 250);
  --ink-3: oklch(0.5 0.01 250);
  --ink-4: oklch(0.65 0.01 250);
  --accent: oklch(0.52 0.07 235);
  --accent-soft: oklch(0.95 0.02 235);
  --accent-ink: oklch(0.32 0.06 235);
  --radius-sm: 6px;
  --radius: 12px;
  --radius-lg: 20px;
  --shadow-2: 0 6px 18px oklch(0.2 0.01 250 / 0.07), 0 2px 4px oklch(0.2 0.01 250 / 0.04);
  --shadow-3: 0 18px 48px oklch(0.2 0.01 250 / 0.10);
  --font-tc: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif;
  --font-en: "Inter", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  --font-serif: "Noto Serif TC", "Source Han Serif TC", Georgia, serif;
}

.breadcrumb-wrap{
  width: 100vw;
  position: relative;
  left: 50%;
  transform: translateX(-50%);
  background: #fff;
  border-bottom: 1px solid var(--line);
  padding: 18px 0;
}

.breadcrumb-wrap .breadcrumb{
  list-style:none; padding:0; margin:0;
  display:flex; flex-wrap:wrap; align-items:center; gap:10px;
  font-size:13px;
  color: var(--ink-3);
  box-shadow:none;
}

/* ── 局部容器 ── */
.na-container {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── Editorial Hero ── */
.editorial-hero {
  background: #fff;
  padding: 48px 0 0;
}
.editorial-hero .topic-link {
  display: inline-block;
  margin-bottom: 18px;
}
.editorial-hero .topic-link a,
.split-text .topic-link a {
  display: inline-flex; align-items: center; gap: 8px;
  color: var(--accent-ink);
  font-size: 12.5px; font-weight: 700;
  letter-spacing: .12em; text-transform: uppercase;
  font-family: var(--font-en);
  text-decoration: none; border-bottom: 0;
}
.editorial-hero .topic-link a::before,
.split-text .topic-link a::before {
  content: ""; width: 28px; height: 1px;
  background: currentColor; flex-shrink: 0;
}
.editorial-hero h1,
.split-text h1 {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: clamp(34px, 4.6vw, 56px);
  line-height: 1.18;
  margin: 0 0 28px;
  max-width: 128ch;
  color: var(--ink);
  letter-spacing: -.005em;
}
.editorial-meta {
  display: flex; flex-wrap: wrap; gap: 20px 32px;
  padding: 18px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  margin: 0;
}
.editorial-meta div { display: flex; flex-direction: column; }
.editorial-meta dt {
  font-family: var(--font-en);
  font-size: 10px; letter-spacing: .2em;
  font-weight: 700; color: var(--ink-4);
  text-transform: uppercase; margin-bottom: 4px;
}
.editorial-meta dd { margin: 0; color: var(--ink); font-weight: 600; font-size: 13px; }
.editorial-meta dd a { color: var(--accent-ink); text-decoration: none; border-bottom: 0; }
/* 突破上層bootstrap col-md-11限制，改為滿版顯示 */
.editorial-article {width: 100vw;position: relative;left: 50%;transform: translateX(-50%);}
/* Portrait 版型：桌機隱藏獨立 Hero，改由 split-text 顯示 */
.editorial-article.cover-portrait .editorial-hero { display: none; }

/* ── Editorial Cover ── */
.editorial-cover { background: #fff; padding: 48px 0 0; }

.cover-frame {
  position: relative; overflow: hidden; margin: 0;
  background: #0a0c0f;
}
.cover-frame .backdrop {
  position: absolute; inset: 0;
  background-position: center; background-size: cover;
  filter: blur(36px) saturate(115%) brightness(.85);
  transform: scale(1.15);
  z-index: 0;
}
.cover-frame .backdrop::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.32) 100%);
}
.cover-frame .foreground {
  position: relative; z-index: 1;
  width: 100%; height: 100%;
  display: grid; place-items: center;
}
.cover-frame .foreground img {
  display: block; width: 100%; height: 100%;
  object-fit: contain; object-position: center;
}

/* Landscape */
.editorial-cover.is-landscape .cover-frame {
  max-width: 1280px; margin: 0 auto; aspect-ratio: 16 / 9;
}

/* Portrait */
.editorial-cover.is-portrait {
  padding: 0;
  background: linear-gradient(180deg, #fff 0%, #fff 60%, var(--bg-soft) 60%, var(--bg-soft) 100%);
}
.editorial-cover.is-portrait .na-container { max-width: 1280px; }
.editorial-cover.is-portrait .split {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  gap: 56px; align-items: stretch;
  padding: 24px 0 56px;
}
.editorial-cover.is-portrait .cover-frame {
  aspect-ratio: 3 / 4;
  border-radius: var(--radius);
  box-shadow: var(--shadow-3);
}
.editorial-cover.is-portrait .split-text {
  display: flex; flex-direction: column; justify-content: center;
  padding: 16px 0;
}

/* Square */
.editorial-cover.is-square { padding: 56px 0 0; }
.editorial-cover.is-square .cover-frame {
  aspect-ratio: 1 / 1; max-width: 720px; margin: 0 auto;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-3);
}

/* ── Editorial Body ── */
.editorial-body-wrap {
  background: #fff;
  padding: 56px 0 64px;
  margin-top: 56px;
  border-top: 1px solid var(--line);
}
.editorial-article.cover-portrait .editorial-body-wrap { margin-top: 0; border-top: 0; }

.editorial-body {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 56px;
  max-width: 1920px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── Aside ── */
.editorial-aside {
  position: sticky; top: 88px; align-self: start;
  font-size: 13px; color: var(--ink-3);
}
.editorial-aside h3 {
  font-family: var(--font-en);
  font-size: 10px; font-weight: 700;
  letter-spacing: .25em; color: var(--ink-4);
  margin: 0 0 12px; text-transform: uppercase;
}

/* TOC */
.editorial-aside .toc {
  margin: 0 0 28px; padding: 0 0 24px;
  border-bottom: 1px solid var(--line);
}
.editorial-aside .toc h2 {
  font-family: var(--font-en);
  font-size: 10px; font-weight: 700;
  letter-spacing: .25em; color: var(--ink-4);
  margin: 0 0 14px; text-transform: uppercase;
  display: flex; align-items: center; gap: 8px;
}
.editorial-aside .toc h2::before {
  content: "目錄";
  font-family: var(--font-tc);
  font-size: 12px; font-weight: 700; letter-spacing: .15em;
  color: var(--ink);
  padding-right: 10px; margin-right: 2px;
  border-right: 1px solid var(--line);
}
.editorial-aside .toc ol {
  list-style: none; padding: 0; margin: 0;
  counter-reset: tocnum;
  display: flex; flex-direction: column; gap: 2px;
}
.editorial-aside .toc li { counter-increment: tocnum; }
.editorial-aside .toc a {
  display: grid; grid-template-columns: 28px 1fr; gap: 10px;
  align-items: baseline;
  padding: 9px 8px 9px 10px; margin-left: -12px;
  border-radius: 6px;
  font-size: 13.5px; line-height: 1.45;
  color: var(--ink-2);
  border-left: 2px solid transparent;
  text-decoration: none;
  transition: all .2s ease;
}
.editorial-aside .toc a::before {
  content: counter(tocnum, decimal-leading-zero);
  font-family: var(--font-en);
  font-size: 10.5px; font-weight: 700; letter-spacing: .05em;
  color: var(--ink-4); padding-top: 1px;
}
.editorial-aside .toc a:hover {
  color: var(--ink);
  background: var(--bg-muted);
  border-left-color: var(--line-strong);
}
.editorial-aside .toc a:hover::before { color: var(--accent-ink); }
.editorial-aside .toc a.is-active {
  color: var(--ink); font-weight: 600;
  border-left-color: var(--accent);
  background: var(--accent-soft);
}
.editorial-aside .toc a.is-active::before { color: var(--accent-ink); }

/* Share */
.editorial-aside .share {
  list-style: none; padding: 0; margin: 0 0 28px;
  display: flex; gap: 8px;
}
.editorial-aside .share a {
  width: 36px; height: 36px;
  display: grid; place-items: center;
  border-radius: 50%;
  border: 1px solid var(--line);
  color: var(--ink-2);
  text-decoration: none;
  transition: all .2s ease;
}
.editorial-aside .share a svg { width: 16px; height: 16px; }
.editorial-aside .share .em a:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
.editorial-aside .share .ln a:hover { background: #06c755; border-color: #06c755; color: #fff; }
.editorial-aside .share .fb a:hover { background: #1877f2; border-color: #1877f2; color: #fff; }

/* Views card */
.editorial-aside .views-card {
  border-top: 1px solid var(--line); padding-top: 16px;
}
.editorial-aside .views-card .num {
  font-family: var(--font-en);
  font-weight: 700; font-size: 28px;
  color: var(--ink); letter-spacing: -.01em;
}
.editorial-aside .views-card .lbl { font-size: 12px; color: var(--ink-3); }

/* ── 文章內文 ── */
.page-txt {
  line-height: 1.95; color: var(--ink-2); font-size: 17px;
  font-family: var(--font-tc);
}
.page-txt > p { margin: 0 0 18px; text-wrap: pretty; }
.page-txt > p:first-of-type::first-letter {
  font-family: var(--font-serif); font-weight: 700;
  font-size: 64px; line-height: .9; float: left;
  padding: 6px 12px 0 0; color: var(--ink);
}
.page-txt > p strong { color: var(--ink); }
.page-txt > h2 {
  margin: 44px 0 16px;
  font-size: 26px; font-weight: 700;
  color: var(--ink); line-height: 1.4;
  position: relative; padding-left: 16px;
}
.page-txt > h2::before {
  content: ""; position: absolute; left: 0; top: .55em;
  width: 4px; height: 18px; background: var(--accent);
  border-radius: 2px;
}
.page-txt > h3 {
  margin: 32px 0 12px; font-size: 18px; font-weight: 700; color: var(--ink);
}
.page-txt > ul, .page-txt > ol { margin: 0 0 22px; padding-left: 22px; }
.page-txt > ul li, .page-txt > ol li { margin: 0 0 8px; }
.page-txt > blockquote {
  margin: 32px 0; padding: 16px 20px 16px 22px;
  border-left: 3px solid var(--accent); background: var(--accent-soft);
  color: var(--ink); font-size: 18px; line-height: 1.7;
  border-radius: 0 8px 8px 0;
  font-family: var(--font-serif); font-style: italic;
}
.page-txt > figure { margin: 32px 0; }
.page-txt > figure figcaption {
  margin-top: 10px; text-align: center; font-size: 13px; color: var(--ink-3);
}
.page-txt code {
  background: var(--bg-muted); padding: 2px 6px; border-radius: 4px;
  font-family: var(--font-en); font-size: 13.5px; color: var(--accent-ink);
}
.page-txt a { color: var(--accent-ink); border-bottom: 1px solid var(--accent); text-decoration: none; }
.page-txt img { max-width: 100%; }

/* 管理員連結 */
.article-admin-links {
  margin-top: 20px; padding-top: 16px;
  border-top: 1px dashed var(--line);
  display: flex; gap: 12px;
}
.article-admin-links a { color: var(--ink-4); font-size: 16px; transition: color .2s; text-decoration: none; }
.article-admin-links a:hover { color: var(--ink); }

/* ── 附件 ── */
.na-attachments {
  max-width: 1100px; margin: 32px auto 0; padding: 20px 24px 0;
  border-top: 1px dashed var(--line);
  font-size: 14px; color: var(--ink-3);
  display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.na-attachments .label { font-weight: 600; color: var(--ink-2); flex-shrink: 0; }
.na-attachments a {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 8px 14px;
  background: var(--bg-muted); border-radius: 999px; color: var(--ink-2);
  text-decoration: none;
  transition: all .2s ease;
}
.na-attachments a svg { width: 14px; height: 14px; flex-shrink: 0; }
.na-attachments a:hover { background: var(--ink); color: #fff; }

/* ── 上下篇導覽（覆寫 style.css 舊樣式）── */
nav.xoops-news-navigation {
  background: var(--bg-soft);
  padding: 28px; margin: 32px auto 0;
  border-radius: var(--radius-lg);
  max-width: 1920px;
  display: grid !important;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  border: none;
}
nav.xoops-news-navigation a {
  display: flex !important; align-items: center; gap: 14px;
  padding: 16px 22px;
  background: #fff;
  border: 1px solid var(--line) !important;
  border-radius: var(--radius);
  transition: all .25s ease;
  min-height: 76px;
  color: var(--ink-2);
  text-decoration: none;
}
nav.xoops-news-navigation a:hover {
  border-color: var(--ink) !important;
  transform: translateY(-1px);
  box-shadow: var(--shadow-2);
  color: var(--ink);
}
nav.xoops-news-navigation .nav-icon {
  width: 36px; height: 36px; flex-shrink: 0;
  display: grid !important; place-items: center;
  border-radius: 50%;
  background: var(--bg-muted); color: var(--ink-2);
  transition: all .25s ease;
}
nav.xoops-news-navigation a:hover .nav-icon { background: var(--ink); color: #fff; }
nav.xoops-news-navigation .nav-icon svg { width: 20px; height: 20px; }
nav.xoops-news-navigation .meta {
  display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1;
}
nav.xoops-news-navigation .lbl {
  font-family: var(--font-en);
  font-size: 11px; font-weight: 700;
  letter-spacing: .15em; color: var(--ink-4);
  text-transform: uppercase;
}
nav.xoops-news-navigation .ttl {
  font-size: 14px; color: var(--ink); font-weight: 600;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
nav.xoops-news-navigation .nav-placeholder { /* empty cell */ }
nav.xoops-news-navigation .next { flex-direction: row-reverse !important; text-align: right; }
nav.xoops-news-navigation .next .meta { align-items: flex-end; }

/* ── 分類 / 標籤區 ── */
.na-topicnav-section {
  max-width: 1100px; margin: 32px auto 0; padding: 32px 24px 0;
}
.na-topicnav-section h2 {
  font-family: var(--font-en);
  font-size: 11px; font-weight: 700;
