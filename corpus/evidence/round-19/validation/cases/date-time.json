{
  "schema": "tabi-webmcp-validation-cases-v1",
  "family": "date-time",
  "fixture": "date-time.html",
  "author": "FamDateTime",
  "cases": [
    {
      "id": "decl-date-time-01",
      "tool": "date-time",
      "input": {
        "date": "2026-10-21",
        "time": "13:45",
        "datetime": "2026-10-21T13:45",
        "month": "2026-10"
      },
      "expect": {
        "status": "Completed",
        "errorTextIncludes": null,
        "submitCount": 1,
        "fields": {
          "date": "2026-10-21",
          "time": "13:45",
          "datetime": "2026-10-21T13:45",
          "month": "2026-10"
        },
        "schema": {
          "properties.date.format": "date",
          "properties.time.format": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "properties.datetime.format": "^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]$",
          "properties.month.format": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "required": []
        }
      },
      "source": {
        "file": "third_party/blink/renderer/core/html/forms/html_form_element.cc",
        "lines": "174-221",
        "url": "https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.97/third_party/blink/renderer/core/html/forms/html_form_element.cc?format=TEXT"
      },
      "question": "Do valid ISO values for all four temporal controls reach the declarative submit handler?",
      "answer": "Yes: one trusted agent-invoked submit completed and retained all four values."
    },
