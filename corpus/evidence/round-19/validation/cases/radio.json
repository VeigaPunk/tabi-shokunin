      "expect": {
        "status": "Completed",
        "errorTextIncludes": null,
        "submitCount": 1,
        "fields": {
          "choice": "beta"
        },
        "schema": {
          "properties.choice.enum": [
            "alpha",
            "beta"
          ]
        }
      },
      "source": {
        "file": "third_party/blink/renderer/core/html/forms/form_mcp_schema.cc",
        "lines": "839-872",
        "url": "https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.97/third_party/blink/renderer/core/html/forms/form_mcp_schema.cc?format=TEXT"
      },
      "question": "For a valid enabled radio value, what enum is exposed and which value is checked after invocation?",
      "answer": "Completed; the derived enum is [alpha, beta], beta is checked, and the submit handler receives choice=beta."
    },
