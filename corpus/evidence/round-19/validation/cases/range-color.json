  "author": "FamRange",
  "cases": [
    {
      "id": "decl-range-color-01",
      "tool": "decl-range-color",
      "input": { "range": 99, "color": "#123456" },
      "expect": {
        "status": "Completed",
        "errorTextIncludes": null,
        "submitCount": 1,
        "fields": { "range": "10", "color": "#123456" },
        "schema": {
          "properties.range.type": "number",
          "properties.range.minimum": 0,
          "properties.range.maximum": 10,
          "properties.range.multipleOf": 2
        }
      },
      "source": {
        "file": "third_party/blink/renderer/core/html/forms/form_mcp_schema.cc",
        "lines": "321-334",
        "url": "https://chromium.googlesource.com/chromium/src/+/refs/tags/154.0.8037.97/third_party/blink/renderer/core/html/forms/form_mcp_schema.cc?format=TEXT"
      },
      "question": "Does a numeric range value above max remain out of range or sanitize to a permitted bound?",
      "answer": "It completed and submitted range 10, the max aligned with step 2."
    },
    {
      "id": "decl-range-color-02",
