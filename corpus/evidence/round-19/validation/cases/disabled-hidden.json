      "tool": "disabled-hidden",
      "input": {
        "disabledField": "disabled-after"
      },
      "expect": {
        "status": "Error",
        "errorTextIncludes": "Input contains a parameter \"disabledField\" but there is no such parameter for the tool",
        "submitCount": 0,
        "fields": {
