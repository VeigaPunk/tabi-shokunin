          "colors": ["red", "blue"]
        },
        "schema": {
          "properties.colors.type": "array",
          "properties.colors.items.type": "string",
          "properties.colors.items.enum": ["red", "green", "blue"],
          "properties.colors.uniqueItems": true
        }
      },
