,8,7,13]},"scrollOffsetX":0,"scrollOffsetY":0,"contentWidth":800,"contentHeight":600}],"strings":["http://127.0.0.1:19431/async.html","TABI-R4-2 async","UTF-8","1A6C219AC9A6530F7757864374D01246","#document","html","HTML","lang","en","HEAD","#text","\n","META","charset","utf-8","TITLE","LINK","rel","stylesheet","href","style.css","BODY","DIV","id","frame","\n  ","H1","page-title","TABI-R4-2 async routes","P","status: ","SPAN","async-status","pending","UL","async-list","A","back","index.html","back to index","SCRIPT","\n(function () {\n  var status = document.getElementById('async-status');\n  var list = document.getElementById('async-list');\n  status.textContent = 'pending';\n  var xhr = new XMLHttpRequest();\n  xhr.open('GET', 'routes.json', true);\n  xhr.onload = function () {\n    var d = JSON.parse(xhr.responseText);\n    d.routes.forEach(function (r, i) {\n      var li = document.createElement('li');\n      li.id = 'route-' + (i + 1);\n      li.textContent = r.name + ' - ' + r.length;\n      list.appendChild(li);\n    });\n    status.textContent = 'ready';\n  };\n  xhr.onerror = function () { status.textContent = 'error'; };\n  xhr.send();\n})();\n","\n\n"]}